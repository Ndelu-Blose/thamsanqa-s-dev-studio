# Copy to `.env.local` for `vercel dev` (never commit secrets).
# Vite `npm run dev` does not run `/api/*`; use `npx vercel dev` to exercise portfolio sync locally.

# GitHub login for GraphQL pinned repos + public events API.
# Must match `SITE_GITHUB_USERNAME` in `src/content/site-links.ts` so API data and UI profile links stay aligned.
GITHUB_USERNAME=
GITHUB_TOKEN=

# Optional: set each repo’s "Website" URL in GitHub → repository → About
# so /api/portfolio-projects can auto-fill "Live demo" without overrides.
